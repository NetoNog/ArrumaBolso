# URL da API do Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima / Publishable Key do Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

